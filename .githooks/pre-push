#!/bin/sh
# pre-push hook: run documentation hygiene and harvest archive checks.
# Installed by: bash scripts/install-hooks.sh
# Skip with:    git push --no-verify

root="$(git rev-parse --show-toplevel 2>/dev/null)"
[ -n "$root" ] || exit 0

bash "$root/scripts/check-docs.sh" || exit 1
exec bash "$root/scripts/check-harvest-archive.sh"
